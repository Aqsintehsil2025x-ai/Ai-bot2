{
  "name": "xfa-discord-test",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply xfa-discord-test --local",
    "db:remote": "wrangler d1 migrations apply xfa-discord-test --remote",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && node --check scripts/register-commands.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
